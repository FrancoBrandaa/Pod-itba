#!/usr/bin/env bash

set -euo pipefail

project_jdk="/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"

if [[ ! -x "$project_jdk/bin/java" ]]; then
    echo "No se encontró OpenJDK 25 en $project_jdk." >&2
    echo "Instalalo con: brew install openjdk@25" >&2
    exit 1
fi

export JAVA_HOME="$project_jdk"
export PATH="$JAVA_HOME/bin:$PATH"

exec mvn "$@"
